# Copy to .env and fill in for your environment. Never commit the real .env.

# --- Site ---
VITE_SITE_URL=https://www.eduerpee.com

# --- Contact form backend (see README "Wiring the contact form") ---
VITE_CONTACT_API_URL=https://api.eduerpee.com/v1/contact

# --- Bot / spam protection (Cloudflare Turnstile shown as example) ---
VITE_TURNSTILE_SITE_KEY=

# --- Analytics (loaded only after cookie consent — see CookieBanner.tsx) ---
VITE_GA4_MEASUREMENT_ID=
VITE_GTM_CONTAINER_ID=
VITE_CLARITY_PROJECT_ID=
VITE_META_PIXEL_ID=
